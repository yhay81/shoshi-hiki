{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shoshi-hiki",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "shoshi-hiki.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": { "crons": ["41 20 * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shoshi-hiki",
      "database_id": "ba2d08e3-4573-4c4a-b3ba-5dcb051f518d",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "NDL_GATE", "class_name": "NdlGate" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NdlGate"] }],
  "assets": { "directory": "./public", "binding": "ASSETS" },
}
